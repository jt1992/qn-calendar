SERVER_PORT=8080
# Optional. Defaults to the user's home directory at ~/.qn-calendar.
# QN_CALENDAR_DATA_DIR=/absolute/path/to/qn-calendar-data

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-email@qq.com
SMTP_PASSWORD=your-qq-email-authorization-code
SMTP_FROM=your-qq-email@qq.com
SMTP_AUTH=true
SMTP_USE_SSL=true
SMTP_USE_TLS=false
